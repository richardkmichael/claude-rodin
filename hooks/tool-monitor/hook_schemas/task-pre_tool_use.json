{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PreToolUse"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "subagent_type": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "prompt",
        "subagent_type"
      ]
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input"
  ],
  "title": "Task PreToolUse Schema",
  "description": "JSON Schema for Task tool PreToolUse events"
}