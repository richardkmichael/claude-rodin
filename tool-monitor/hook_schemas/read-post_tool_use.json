{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PostToolUse"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "file_path": {
          "type": "string"
        },
        "limit": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        }
      },
      "required": [
        "file_path"
      ]
    },
    "tool_response": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "file": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string"
            },
            "content": {
              "type": "string"
            },
            "numLines": {
              "type": "number"
            },
            "startLine": {
              "type": "number"
            },
            "totalLines": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input",
    "tool_response"
  ],
  "title": "Read PostToolUse Schema",
  "description": "JSON Schema for Read tool PostToolUse events"
}