{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PreToolUse"
    },
    "tool_name": {
      "type": "string"
    },
    "tool_input": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "timeout": {
          "type": "number"
        }
      },
      "required": [
        "command",
        "description"
      ]
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input"
  ],
  "title": "Bash PreToolUse Schema",
  "description": "JSON Schema for Bash tool PreToolUse events"
}